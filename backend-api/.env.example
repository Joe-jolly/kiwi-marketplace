# Copy this file to .env and adjust values as needed.
# This file must never contain real secrets.

# Local PostGIS-enabled PostgreSQL, provided by docker-compose.yml at the repo root.
# Run `docker compose up -d` from the repo root before starting the backend.
DATABASE_URL="postgresql://kiwi:kiwi_dev_password@localhost:5433/kiwi_marketplace?schema=public"

# JWT
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="15m"

# Server
PORT=3000

# Cloudflare R2 (Image Storage — see docs/adr/ADR-005-image-storage-architecture.md)
R2_ACCOUNT_ID="replace-with-your-cloudflare-account-id"
R2_ACCESS_KEY_ID="replace-with-your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="replace-with-your-r2-secret-access-key"
R2_BUCKET_NAME="kiwi-marketplace-images"
R2_PUBLIC_BASE_URL="https://replace-with-your-public-r2-domain"
