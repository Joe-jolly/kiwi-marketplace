// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum PostStatus {
  ACTIVE
  RESERVED
  COMPLETED
  PAUSED
  DELETED
}

model User {
  id              String  @id @default(uuid())
  phone           String  @unique
  isPhoneVerified Boolean @default(false)

  passwordHash String

  displayName String
  avatarUrl   String?

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts              Post[]
  favorites          Favorite[]
  chatsAsParticipant Chat[]
  sentMessages       Message[]
}

model Category {
  id     String @id @default(uuid())
  name   String @unique
  schema Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts Post[]
}

model Post {
  id String @id @default(uuid())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  title       String
  price       Int
  description String
  details     Json
  latitude    Float
  longitude   Float
  status      PostStatus @default(ACTIVE)

  // Set when status transitions to DELETED; cleared on restore. Null means
  // the post has never been soft-deleted (or was restored).
  deletedAt DateTime?

  // Derived, generated column (see ADR-004: Geospatial Feed Architecture).
  // Always computed by the database from `latitude`/`longitude`; never
  // written to by Prisma Client. The generated-column expression and its
  // GiST index are defined by hand in the migration SQL, since Prisma
  // cannot express generated columns natively — this is the one field
  // application code accesses only through the single sanctioned raw SQL
  // query described in ADR-004.
  location Unsupported("geography(Point, 4326)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images    PostImage[]
  favorites Favorite[]
  chats     Chat[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([status])
  @@index([ownerId, status, deletedAt])
}

model PostImage {
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  imageUrl     String
  displayOrder Int
  createdAt    DateTime @default(now())

  @@id([postId, displayOrder])
}

// Bridge table for the User <-> Post many-to-many "saved listings"
// relationship (Database Constitution §10). Composite PK (no separate
// `id`, no `updatedAt`) mirrors `PostImage`'s precedent — rows here are
// create/delete-only, never updated in place. The composite PK itself
// satisfies the Database Constitution's mandated `UNIQUE(user_id, post_id)`;
// `@@index([postId])` adds the reverse lookup the same section requires
// (the PK's own index only optimizes `userId`-first lookups).
model Favorite {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([postId])
}

// One Post x One Participant = One Chat (Database Constitution §11/§21,
// Technical Constitution §18). "Participant" is always the non-owner side;
// the owner side is derived from `post.ownerId`, not denormalized here —
// the Database Constitution's required-index list for Chat names only
// `post_id`/`participant_id`, not an owner column.
//
// `ownerLastReadAt`/`participantLastReadAt` are the approved Step 1 design
// for read receipts: a per-side "read up to this time" watermark, not a
// per-message `readAt`. A message shows the UI's ✓✓ state (UI-UX
// Constitution §16) whenever `message.createdAt <= theOtherSide'sWatermark`
// — fully derivable client-side, no per-message write needed.
//
// `lastMessageAt` is a small, necessary addition beyond the Step 0 plan
// (flagged in the Step 1 report): without it, "my chats" would only be
// sortable by when the chat first started, not by recent activity, which
// is the sort order every chat UI (and "ChatList", UI-UX Constitution §6)
// actually needs. Updated in the same transaction as each new `Message`.
model Chat {
  id String @id @default(uuid())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  participantId String
  participant   User   @relation(fields: [participantId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  lastMessageAt DateTime  @default(now())

  ownerLastReadAt       DateTime?
  participantLastReadAt DateTime?

  messages Message[]

  @@unique([postId, participantId])
  @@index([participantId])
}

// Text-only in MVP (Database Constitution §12, MVP Scope Lock §21 —
// images/files/voice explicitly excluded). Immutable, append-only: no
// `updatedAt`, mirroring the `PostImage`/`Favorite` precedent.
model Message {
  id String @id @default(uuid())

  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  content   String
  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}
